{
  "name": "frightertainment-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:pages": "node scripts/build-pages.mjs && node scripts/build-editorial.mjs",
    "check": "npm run check:syntax && node scripts/check-content.mjs && node scripts/check-links.mjs && node scripts/check-streaming-discovery.mjs",
    "audit:vault": "node scripts/audit-vault.mjs",
    "test": "node --test",
    "test:browser": "playwright test",
    "sync:manual-films": "node scripts/sync-manual-films.mjs",
    "validate:worker": "wrangler deploy --dry-run --outdir /tmp/frightertainment-worker-dry-run",
    "worker:dev": "wrangler dev --persist-to .wrangler/discovery",
    "worker:migrations:local": "wrangler d1 migrations apply frightertainment-discovery --local --persist-to .wrangler/discovery",
    "serve": "python3 -m http.server 8080",
    "build:preview": "npm run build:pages && node scripts/build-preview.mjs && node scripts/version-public-assets.mjs",
    "build:production": "npm run build:pages && node scripts/build-production.mjs && node scripts/version-public-assets.mjs",
    "check:published": "node scripts/check-published-links.mjs",
    "check:syntax": "node scripts/check-js-syntax.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "wrangler": "4.149.0"
  }
}
